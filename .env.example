# Keep this local for offline operation. Cloud sync will use separate configuration.
DATABASE_URL=sqlite:///./temp.db
DEBUG=true

# Email password recovery (STARTTLS, typically port 587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pharmacy@example.com
SMTP_STARTTLS=true
# Frontend page that accepts ?token=... and submits the new password to the API.
PASSWORD_RESET_URL=https://your-frontend.example.com/reset-password

# Administration only. Never distribute these credentials with desktop clients.
SUPABASE_PROJECT_URL=https://nosqyzumgkripfqnqknw.supabase.co
SUPABASE_ADMIN_DB_HOST=db.nosqyzumgkripfqnqknw.supabase.co
SUPABASE_ADMIN_DB_PORT=5432
SUPABASE_ADMIN_DB_NAME=postgres
SUPABASE_ADMIN_DB_USER=postgres
SUPABASE_ADMIN_DB_SSLROOTCERT=certs/supabase-prod-ca-2021.crt
SUPABASE_ADMIN_DB_PASSWORD=

# Device enrollment: see SYNC_SETUP_README.md.
SYNC_ENABLED=false
SYNC_PHARMACY_ID=
SYNC_DEVICE_ID=
SYNC_DEVICE_SECRET=
SUPABASE_PUBLISHABLE_KEY=
