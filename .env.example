# Hosted API uses one persistent PostgreSQL database. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_SCHEMA=erp_app
REQUIRE_POSTGRES=true
DEBUG=false
CORS_ORIGINS=["https://your-frontend.example.com","http://localhost:5173"]

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pharmacy@example.com
SMTP_STARTTLS=true
SMTP_CC_EMAIL=
PASSWORD_RESET_URL=https://your-frontend.example.com/reset-password
